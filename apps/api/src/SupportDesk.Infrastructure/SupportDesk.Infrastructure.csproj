<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Implements the domain's repositories and the application's abstractions with EF Core and
    SQL Server: the DbContext, mappings, migrations and seed data (Data/), repositories, read
    queries, the system clock, and authentication.
  -->
  <ItemGroup>
    <ProjectReference Include="../SupportDesk.Application/SupportDesk.Application.csproj" />
    <ProjectReference Include="../SupportDesk.Domain/SupportDesk.Domain.csproj" />
  </ItemGroup>

  <!--
    Brings in ASP.NET Core types: PasswordHasher<T> (Microsoft.Extensions.Identity.Core) and
    the JWT creation types (System.IdentityModel.Tokens.Jwt), without dragging in the web stack.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>